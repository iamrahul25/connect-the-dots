{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connect-the-dots.app/schema/level.schema.json",
  "title": "Connect the Dots level",
  "type": "object",
  "required": ["id", "pack", "index", "formatVersion", "size", "dots", "solution", "difficulty", "stars"],
  "$defs": {
    "cell": {
      "type": "array",
      "description": "[row, col], zero-based",
      "items": { "type": "integer", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^(p\\d{2}-l\\d{3}|daily-\\d{4}-\\d{2}-\\d{2})$" },
    "pack": { "type": "integer", "minimum": 0 },
    "index": { "type": "integer", "minimum": 1 },
    "formatVersion": { "enum": [1, 2], "description": "2 = uses teleporters, tunnels, rotators or locks" },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 3, "maximum": 16 },
        "height": { "type": "integer", "minimum": 3, "maximum": 16 }
      }
    },
    "dots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["color", "start", "end"],
        "properties": {
          "color": { "type": "integer", "minimum": 0, "maximum": 11 },
          "start": { "$ref": "#/$defs/cell" },
          "end": { "$ref": "#/$defs/cell" }
        }
      }
    },
    "walls": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
    "bridges": { "type": "array", "items": { "$ref": "#/$defs/cell" } },
    "warps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["axis", "index"],
        "properties": {
          "axis": { "enum": ["row", "col"] },
          "index": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "teleporters": {
      "type": "array",
      "description": "Linked gate pairs; entering either gate continues out of the other",
      "items": {
        "type": "object",
        "required": ["a", "b"],
        "properties": { "a": { "$ref": "#/$defs/cell" }, "b": { "$ref": "#/$defs/cell" } }
      }
    },
    "tunnels": {
      "type": "array",
      "description": "Straight one-lane pieces the player rotates; start is the unsolved orientation",
      "items": {
        "type": "object",
        "required": ["cell", "start"],
        "properties": { "cell": { "$ref": "#/$defs/cell" }, "start": { "enum": ["h", "v"] } }
      }
    },
    "rotators": {
      "type": "array",
      "description": "L-shaped pieces named by the two sides they connect",
      "items": {
        "type": "object",
        "required": ["cell", "start"],
        "properties": { "cell": { "$ref": "#/$defs/cell" }, "start": { "enum": ["ne", "se", "sw", "nw"] } }
      }
    },
    "locks": {
      "type": "array",
      "description": "A door opens once a completed path runs through its key",
      "items": {
        "type": "object",
        "required": ["key", "door"],
        "properties": { "key": { "$ref": "#/$defs/cell" }, "door": { "$ref": "#/$defs/cell" } }
      }
    },
    "solution": {
      "type": "object",
      "description": "Dot index -> ordered cells from start to end",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/cell" }, "minItems": 2 }
    },
    "difficulty": {
      "type": "object",
      "required": ["score", "band"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["relaxed", "easy", "medium", "hard", "expert"] },
        "metrics": { "type": "object" }
      }
    },
    "stars": {
      "type": "object",
      "required": ["perfectMoves", "twoStarMoves"],
      "properties": {
        "perfectMoves": { "type": "integer", "minimum": 1 },
        "twoStarMoves": { "type": "integer", "minimum": 1 }
      }
    },
    "meta": { "type": "object" }
  }
}
