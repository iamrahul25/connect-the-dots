# PostHog (anonymous analytics, Android/iOS only). Both values are public and are compiled into the app.
# Project API key: PostHog → Project settings → "Project API key" (starts with phc_).
EXPO_PUBLIC_POSTHOG_API_KEY=
# US Cloud: https://us.i.posthog.com   EU Cloud: https://eu.i.posthog.com
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
